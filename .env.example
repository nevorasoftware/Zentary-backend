DATABASE_URL="postgresql://user:change-me@localhost:5432/zentary"
PORT=3000
JWT_SECRET="change-me"
QR_HMAC_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PAYMENT_API_KEY="change-me"
PAYMENT_WEBHOOK_SECRET="change-me"
WOMPI_CLIENT_ID="change-me"
WOMPI_CLIENT_SECRET="change-me"
# Conciliación periódica de pagos pendientes (minutos; 0 = apagado, por defecto 10)
WOMPI_RECONCILE_INTERVAL_MINUTES="10"
NODE_ENV="production"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="change-me"
WHATSAPP_ACCESS_TOKEN="change-me"
WHATSAPP_VERIFY_TOKEN="change-me"

# Zona horaria para interpretar y mostrar horas de visitas (opcional, por defecto America/Guatemala)
APP_TIMEZONE="America/Guatemala"
