generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  ADMIN
  GUARD
}

enum VisitStatus {
  PENDIENTE_REGISTRO
  DATOS_COMPLETADOS
  INGRESADA
  CANCELADA
  VENCIDA
  IN_PROGRESS
  COMPLETED
}

enum AccessCategory {
  EN_CURSO
  HISTORIAL
  FRECUENTE
}

enum CarrierType {
  CARGO_EXPRESS
  DHL
  FEDEX
  TRANS_EXPRESS
  UPS
  OTRO
}

enum ParcelStatus {
  PENDING
  PICKED_UP
  CANCELLED
}

enum PqrsCategory {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
}

enum PqrsStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum AnnouncementCategory {
  MANTENIMIENTO
  URGENTE
  EVENTO
  GENERAL
}

model Community {
  id            String         @id @default(uuid())
  name          String         @default("Residencial Zentary")
  address       String?
  city          String?
  logoUrl       String?
  properties    Property[]
  users         User[]
  announcements Announcement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String
  mustChangePassword Boolean         @default(false)
  fullName           String
  phone              String?
  role               Role            @default(RESIDENT)
  isActive           Boolean         @default(true)
  avatarUrl          String?
  communityId        String?
  community          Community?      @relation(fields: [communityId], references: [id])
  propertyId         String?
  property           Property?       @relation(fields: [propertyId], references: [id])
  visits             Visit[]
  guardVisits        Visit[]         @relation("GuardVisits")
  parcels            Parcel[]
  pqrsList           Pqrs[]
  pqrsMessages       PqrsMessage[]
  payments           Payment[]
  announcements      Announcement[]  @relation("AuthorAnnouncements")
  frequentConfig     FrequentAccessConfig?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Property {
  id          String     @id @default(uuid())
  unitNumber  String     // e.g. Apt 4B, Casa 12
  block       String?    // e.g. Torre 1, Manzana A
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])
  residents   User[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Visit {
  id               String         @id @default(uuid())
  residentId       String
  resident         User           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  visitorName      String
  visitorPhone     String?
  visitorDni       String?
  documentType     String?        // DUI, PASAPORTE, OTRO
  documentNumber   String?
  documentPhotoUrl String?
  hasVehicle       Boolean        @default(false)
  vehiclePlate     String?
  vehicleModel     String?
  vehicleColor     String?
  category         AccessCategory @default(EN_CURSO)
  status           VisitStatus    @default(PENDIENTE_REGISTRO)
  allowedDays      String?
  allowedHours     String?
  validFrom        DateTime?
  validUntil       DateTime?
  qrCode           String?
  notes            String?
  publicToken      String?        @unique
  entryDate        DateTime?
  exitDate         DateTime?
  guardId          String?
  guard            User?          @relation("GuardVisits", fields: [guardId], references: [id])
  gateName         String?        @default("Puerta Principal")
  tokens           VisitToken[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model VisitToken {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FrequentAccessConfig {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hideFrequentAccessBanner   Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

model Parcel {
  id               String       @id @default(uuid())
  residentId       String
  resident         User         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  carrier          CarrierType
  customCarrier    String?
  trackingNumber   String?
  photoUrl         String?
  notes            String?
  status           ParcelStatus @default(PENDING)
  receivedAt       DateTime     @default(now())
  pickedUpAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Pqrs {
  id           String       @id @default(uuid())
  residentId   String
  resident     User         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  category     PqrsCategory @default(PETICION)
  subject      String
  description  String
  status       PqrsStatus   @default(OPEN)
  messages     PqrsMessage[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model PqrsMessage {
  id        String   @id @default(uuid())
  pqrsId    String
  pqrs      Pqrs     @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  message   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  category    AnnouncementCategory @default(GENERAL)
  communityId String?
  community   Community?           @relation(fields: [communityId], references: [id])
  authorId    String
  author      User                 @relation("AuthorAnnouncements", fields: [authorId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Payment {
  id                   String        @id @default(uuid())
  residentId           String
  resident             User          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId           String?
  property             Property?     @relation(fields: [propertyId], references: [id])
  concept              String
  amount               Float
  currency             String        @default("USD")
  status               PaymentStatus @default(PENDING)
  dueDate              DateTime
  paidAt               DateTime?
  paymentMethod        String?
  externalTransactionId String?
  rawGatewayResponse   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}
