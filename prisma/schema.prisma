generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESIDENT
  ADMIN
  GUARD
}

enum VisitStatus {
  PENDIENTE_REGISTRO
  DATOS_COMPLETADOS
  INGRESADA
  CANCELADA
  VENCIDA
  IN_PROGRESS
  COMPLETED
}

enum AccessCategory {
  EN_CURSO
  HISTORIAL
  FRECUENTE
}

enum CarrierType {
  CARGO_EXPRESS
  DHL
  FEDEX
  TRANS_EXPRESS
  UPS
  OTRO
}

enum ParcelStatus {
  PENDING
  PICKED_UP
  CANCELLED
}

enum PqrsCategory {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
}

enum PqrsStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum AnnouncementCategory {
  MANTENIMIENTO
  URGENTE
  EVENTO
  GENERAL
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ReservationPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Community {
  id                  String               @id @default(uuid())
  name                String               @default("Residencial Zentary")
  address             String?
  city                String?
  logoUrl             String?
  properties          Property[]
  users               User[]
  announcements       Announcement[]
  amenities           Amenity[]
  amenityReservations AmenityReservation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  mustChangePassword  Boolean              @default(false)
  fullName            String
  phone               String?
  role                Role                 @default(RESIDENT)
  isActive            Boolean              @default(true)
  avatarUrl           String?
  pushToken           String?
  communityId         String?
  community           Community?           @relation(fields: [communityId], references: [id])
  propertyId          String?
  property            Property?            @relation(fields: [propertyId], references: [id])
  visits              Visit[]
  guardVisits         Visit[]              @relation("GuardVisits")
  parcels             Parcel[]
  pqrsList            Pqrs[]
  pqrsMessages        PqrsMessage[]
  payments            Payment[]
  announcements       Announcement[]       @relation("AuthorAnnouncements")
  amenityReservations AmenityReservation[]
  frequentConfig      FrequentAccessConfig?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Property {
  id          String     @id @default(uuid())
  unitNumber  String     // e.g. Apt 4B, Casa 12
  block       String?    // e.g. Torre 1, Manzana A
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])
  residents   User[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Visit {
  id               String         @id @default(uuid())
  residentId       String
  resident         User           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  visitorName      String
  visitorPhone     String?
  visitorDni       String?
  documentType     String?        // DUI, PASAPORTE, OTRO
  documentNumber   String?
  documentPhotoUrl String?
  hasVehicle       Boolean        @default(false)
  vehiclePlate     String?
  vehicleModel     String?
  vehicleColor     String?
  category         AccessCategory @default(EN_CURSO)
  status           VisitStatus    @default(PENDIENTE_REGISTRO)
  allowedDays      String?
  allowedHours     String?
  validFrom        DateTime?
  validUntil       DateTime?
  qrCode           String?
  notes            String?
  publicToken      String?        @unique
  entryDate        DateTime?
  exitDate         DateTime?
  guardId          String?
  guard            User?          @relation("GuardVisits", fields: [guardId], references: [id])
  gateName         String?        @default("Puerta Principal")
  tokens           VisitToken[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model VisitToken {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FrequentAccessConfig {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hideFrequentAccessBanner Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model Parcel {
  id               String       @id @default(uuid())
  residentId       String
  resident         User         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  carrier          CarrierType
  customCarrier    String?
  trackingNumber   String?
  photoUrl         String?
  notes            String?
  status           ParcelStatus @default(PENDING)
  receivedAt       DateTime     @default(now())
  pickedUpAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Pqrs {
  id           String       @id @default(uuid())
  residentId   String
  resident     User         @relation(fields: [residentId], references: [id], onDelete: Cascade)
  category     PqrsCategory @default(PETICION)
  subject      String
  description  String
  status       PqrsStatus   @default(OPEN)
  messages     PqrsMessage[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model PqrsMessage {
  id        String   @id @default(uuid())
  pqrsId    String
  pqrs      Pqrs     @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  message   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  category    AnnouncementCategory @default(GENERAL)
  communityId String?
  community   Community?           @relation(fields: [communityId], references: [id])
  authorId    String
  author      User                 @relation("AuthorAnnouncements", fields: [authorId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Payment {
  id                   String        @id @default(uuid())
  residentId           String
  resident             User          @relation(fields: [residentId], references: [id], onDelete: Cascade)
  propertyId           String?
  property             Property?     @relation(fields: [propertyId], references: [id])
  concept              String
  amount               Float
  currency             String        @default("USD")
  status               PaymentStatus @default(PENDING)
  dueDate              DateTime
  paidAt               DateTime?
  paymentMethod        String?
  externalTransactionId String?
  rawGatewayResponse   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Amenity {
  id                 String               @id @default(uuid())
  communityId        String
  community          Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name               String
  type               String               @default("Salón")
  imageUrl           String?
  price              Float                @default(0.0)
  maxReservationTime Int                  @default(4) // Max hours
  availableDays      String               @default("Lunes,Martes,Miércoles,Jueves,Viernes,Sábado,Domingo")
  startTime          String               @default("08:00")
  endTime            String               @default("22:00")
  active             Boolean              @default(true)
  availabilities     AmenityAvailability[]
  reservations       AmenityReservation[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model AmenityAvailability {
  id        String   @id @default(uuid())
  amenityId String
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   @default("08:00")
  endTime   String   @default("22:00")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AmenityReservation {
  id                String                   @id @default(uuid())
  amenityId         String
  amenity           Amenity                  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  communityId       String
  community         Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  residentId        String
  resident          User                     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  reservationDate   DateTime
  startTime         String                   // e.g. "10:00"
  endTime           String                   // e.g. "12:00"
  price             Float                    @default(0.0)
  reservationStatus ReservationStatus        @default(PENDING)
  paymentStatus     ReservationPaymentStatus @default(NOT_REQUIRED)
  paymentReference  String?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([amenityId, reservationDate])
  @@index([communityId])
  @@index([residentId])
}
